{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SharonVivenix/best-generative-optimization-tools/main/schema/tools.schema.json",
  "title": "Generative optimization tools dataset",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/tool" },
  "$defs": {
    "plan": {
      "type": "object",
      "required": ["plan", "price", "recommends", "drafts", "publishes"],
      "additionalProperties": false,
      "properties": {
        "plan": { "type": "string", "minLength": 1 },
        "price": { "type": ["integer", "null"], "minimum": 0, "description": "USD per month, null when quoted by sales" },
        "unit": { "type": "string", "description": "Billing unit shown after the price, for example /mo per domain" },
        "engines": { "type": "string", "description": "Human readable engine coverage" },
        "engines_included": { "type": "integer", "minimum": 1, "description": "AI engines tracked at once on this plan" },
        "recommends": { "type": "boolean", "description": "Names the page to change or the source to pitch" },
        "drafts": { "type": "boolean", "description": "Writes the article or the page rewrite" },
        "publishes": { "type": "boolean", "description": "Pushes content into a CMS" }
      }
    },
    "tool": {
      "type": "object",
      "required": ["id", "name", "url", "entry", "top", "trial"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "entry": {
          "allOf": [{ "$ref": "#/$defs/plan" }],
          "required": ["engines", "engines_included"]
        },
        "top": { "$ref": "#/$defs/plan" },
        "trial": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
